# UCC Workspace — optional server-provided credentials.
#
# Copy this file to ".env" (same folder) on the server and fill in the values
# you want fixed here instead of typed per-browser in Settings. Leave any line
# blank/removed to keep that field editable in the app as normal.
#
# HOW IT WORKS: these are read at BUILD time — after editing .env you must
# rebuild (npm run build -- --base=/ucc_academic_hub/) for changes to apply.
# In the Settings page each filled-in value shows read-only with a small lock
# note. Test / Save / connection buttons still work.
#
# SECURITY: because this is a static build, every value below is embedded into
# the public JavaScript bundle. That is fine for the Google client ID and the
# Supabase URL + Anon key (all public by design). It does NOT truly hide
# VITE_ERP_API_SECRET — anyone who inspects the page source could read it. If
# that matters, put the ERPNext credentials in the nginx /erp proxy instead.
#
# .env is gitignored, so real credentials here are never committed.

# --- ERPNext ---
VITE_ERP_BASE_URL=https://sms.unitedceres.edu.sg
VITE_ERP_API_KEY=
VITE_ERP_API_SECRET=
VITE_ERP_DOCTYPE=

# --- Google (Sheets export) — client ID is public by design ---
VITE_GOOGLE_CLIENT_ID=

# --- Supabase (cloud sync) — URL + Anon key are public by design ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Anthropic (AI report writer in Student Survey Analysis) ---
# Used only by the Survey tool to have Claude write the report narrative from
# your computed figures. Per-report API cost is billed to this key. NOTE: like
# the ERPNext secret above, a VITE_* key is embedded in the public bundle and
# is NOT truly hidden — only set it here for an internal, trusted deployment.
VITE_ANTHROPIC_API_KEY=
